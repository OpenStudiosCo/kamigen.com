extends website.pug

block append title
  if wiki_home
    | #{page_title_string} | Kamigen
  else
    | #{page_title_string} | World | Kamigen

block append content
  section.page-hero
    .wrap
      p.section-kicker World &amp; production
      h1= page_title_string
  .content-shell
    aside.section-nav(aria-label='World and production')
      nav
        h2 Kamigen World
        a.item(href='/wiki/characters.html') Characters
        a.item(href='/wiki/locations.html') Locations
        a.item(href='/wiki/lore.html') Lore
        a.item(href='/wiki/timeline.html') Timeline
        h2 Production
        a.item(href='/blog.html') Blog
        a.item(href='/wiki/info_sheets.html') Character and story info sheets
        a.item(href='/wiki/concept_art.html') Concept art
        a.item(href='/wiki/production_notes.html') Production notes
        a.item(href='/wiki/screenshots.html') Screenshots
    article.prose
      if !wiki_home
        nav.breadcrumb(aria-label='Breadcrumb')
          a(href='/wiki.html') World
          span(aria-hidden='true') /
          span= page_title_string
      block page_content
