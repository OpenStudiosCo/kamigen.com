doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    title
      block title
    base(href='/')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='theme-color' content='#061a2c')
    meta(name='description' content='Kamigen is a solarpunk world based around Visayan culture. Read the comics or play the game demo.')
    meta(name='robots' content='index, follow, max-image-preview:large')
    meta(property='og:type' content='website')
    meta(property='og:site_name' content='Kamigen')
    meta(property='og:image' content='https://kamigen.com/art/screenshots/Kamigen%20Island%20shot.PNG')
    meta(property='og:image:alt' content='Kamigen Island at sunset')
    meta(name='twitter:card' content='summary_large_image')
    meta(name='twitter:image' content='https://kamigen.com/art/screenshots/Kamigen%20Island%20shot.PNG')
    link(rel='icon' href='/favicon.ico')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap' rel='stylesheet')
    script(type='application/ld+json').
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://kamigen.com/#website",
            "url": "https://kamigen.com/",
            "name": "Kamigen",
            "description": "Kamigen is a solarpunk world based around Visayan culture.",
            "publisher": {"@id": "https://kamigen.com/#organization"}
          },
          {
            "@type": "Organization",
            "@id": "https://kamigen.com/#organization",
            "name": "Open Studios",
            "url": "https://openstudios.xyz/"
          }
        ]
      }
    block head
  body
    block page
    block shaders
    include /src/templates/scripts.pug
