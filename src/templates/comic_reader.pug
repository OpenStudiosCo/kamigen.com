extends website.pug

block append title
  | #{page_title_string} | Comics | Kamigen

block append content
  article.comic-reader
    header.reader-head
      nav.reader-breadcrumb(aria-label='Breadcrumb')
        a(href='/comics.html') Comics
        span(aria-hidden='true') /
        a(href=issue_url)= issue
        span(aria-hidden='true') /
        span= page_title_string
      h1= page_title_string
    nav.reader-controls(aria-label='Comic page navigation')
      a.btn.btn-secondary(href=previous_url rel='prev') ← Previous
      if next_url
        a.btn.btn-primary(href=next_url rel='next') Next →
      else
        span.reader-end Latest page
    figure.comic-page
      if next_url
        a(href=next_url aria-label=`Continue to the page after ${page_title_string}`)
          img(src=image_url alt=`Kamigen comic ${page_title_string}` decoding='async' fetchpriority='high')
      else
        a(href=issue_url aria-label=`Return to ${issue}`)
          img(src=image_url alt=`Kamigen comic ${page_title_string}` decoding='async' fetchpriority='high')
    nav.reader-controls(aria-label='Comic page navigation')
      a.btn.btn-secondary(href=previous_url rel='prev') ← Previous
      if next_url
        a.btn.btn-primary(href=next_url rel='next') Next →
      else
        span.reader-end Latest page
    if next_url
      p.reader-hint Select the page to continue reading.
    section.reader-transcript#page_script
      h2 Page transcript
      pre
        block page_script
    section.reader-comments(aria-label='Comments')
      #disqus_thread
