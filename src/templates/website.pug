extends layout.pug

block append head
  link(href='/dist/website.css', rel='stylesheet')

block append page
  a.skip(href='#content') Skip to story
  header.mast
    a.brand(href='/' aria-label='Kamigen. Hover or focus to see the name in Badlit.')
      img.en(src='/new/src/assets/Kamigen%20Logo.svg' alt='')
      img.badlit(src='/new/src/assets/Kamigen%20Logo%20-%20Badlit.svg' alt='')
      span.brand-hint Kamigen
    button.nav-burger(type='button' aria-expanded='false' aria-controls='primary-navigation') Menu
    ul.nav-links#primary-navigation
      li: a(href='/comics.html') Comics
      li: a(href='/game.html') Game
      li: a(href='/wiki.html') World
      li: a(href='/blog.html') Blog
  main.site-main#content
    block content
  footer.site-foot
    a.foot-brand(href='/' aria-label='Kamigen home')
      img(src='/new/src/assets/Kamigen%20Logo%20-%20Badlit.svg' alt='')
      small Kamigen
    p
      | Independently developed by #[a(href='https://openstudios.xyz') Open Studios]. #[a(href='/shop.html') Shop] · #[a(href='https://github.com/paulbrzeski/kamigen') Source]
    .social
      a(href='https://www.facebook.com/kamigenofficial/' title='Kamigen on Facebook')
        img(src='/assets/optimized/social/facebook.webp' alt='Facebook' width='52' height='52' loading='lazy' decoding='async')
      a(href='https://www.instagram.com/kamigen_comics/' title='Kamigen Comics on Instagram')
        img(src='/assets/optimized/social/instagram.webp' alt='Instagram' width='52' height='52' loading='lazy' decoding='async')
