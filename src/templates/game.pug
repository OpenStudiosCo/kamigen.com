doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    title
      block title
    base(href='/')
    meta(name='viewport' content='width=device-width, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0')
    meta(name='theme-color' content='#061a2c')
    meta(name='description' content='Explore the interactive Kamigen game demo.')
    meta(name='robots' content='index, follow, max-image-preview:large')
    meta(property='og:type' content='website')
    meta(property='og:site_name' content='Kamigen')
    meta(property='og:image' content='https://kamigen.com/art/screenshots/Kamigen%20Island%20shot.PNG')
    meta(property='og:image:alt' content='Kamigen Island at sunset')
    meta(name='twitter:card' content='summary_large_image')
    meta(name='twitter:image' content='https://kamigen.com/art/screenshots/Kamigen%20Island%20shot.PNG')
    link(rel='icon' href='/favicon.ico')
    link(href='https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.4.1/semantic.min.css', rel='stylesheet')
    link(href='./dist/game.css', rel='stylesheet')
    block head
  body
    block page
    include /src/templates/shaders.pug
    block scripts
      include /src/templates/game-vendor-scripts.pug
      script(src='./dist/app.js')
      