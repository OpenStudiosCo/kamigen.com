{
  "name": "Kamigen",
  "version": "0.0.2",
  "description": "A solarpunk comic and game world based around Visayan culture",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulbrzeski/kamigen"
  },
  "keywords": [
    "comics",
    "solarpunk",
    "visayan"
  ],
  "scripts": {
    "build": "npm run css && npm run pug && npm run rollup",
    "css": "./node_modules/.bin/stylus src/styles -o dist",
    "pug": "pug src/pages -P -o . -b . && node tools/generate-site-metadata.js",
    "seo": "node tools/generate-site-metadata.js",
    "rollup": "rollup -c",
    "validate": "node tools/validate-site.js",
    "test": "npm run build && npm run validate && npm run test:comics-editor",
    "test:comics-editor": "node tools/comics-editor-test.js",
    "editor": "node tools/comics-editor-server.js",
    "dev": "http-server -p 9988 -c-1 .",
    "watch": "node dev.js"
  },
  "author": "Paul Brzeski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/paulbrzeski/kamigen/issues"
  },
  "devDependencies": {
    "chokidar": "^3.5.2",
    "cross-spawn": "^7.0.3",
    "http-server": "^14.1.1",
    "pug": "^3.0.3",
    "pug-cli": "^1.0.0-alpha6",
    "rollup": "^2.58.0",
    "rollup-plugin-buble": "^0.19.8",
    "rollup-plugin-pug": "^1.1.1",
    "stylus": "^0.64.0"
  }
}
